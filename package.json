{
  "name": "nearcited",
  "private": true,
  "version": "0.1.0",
  "description": "Local visibility tracking across Google local search and AI answers",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @nearcited/api --filter @nearcited/web dev",
    "build": "pnpm --filter @nearcited/web build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "cf:deploy": "pnpm build && pnpm --filter @nearcited/api run deploy",
    "db:types": "supabase gen types typescript --local > packages/shared/src/database.types.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "typescript": "^7.0.2"
  }
}
