{
  "name": "nearcited",
  "private": true,
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "description": "Local visibility tracking across Google local search and AI answers",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @nearcited/api --filter @nearcited/web dev",
    "build": "pnpm --filter @nearcited/web build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:scripts": "node --test scripts/sync-main.test.mjs scripts/bootstrap-private.test.mjs scripts/prepare-tuning.test.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:scripts && pnpm build",
    "cf:deploy": "pnpm build && pnpm --filter @nearcited/api run deploy",
    "bootstrap:private": "node scripts/bootstrap-private.mjs",
    "sync:main": "node scripts/sync-main.mjs",
    "sync:agents": "node scripts/sync-agents.mjs",
    "sync:agents:check": "node scripts/sync-agents.mjs --check",
    "db:types": "supabase gen types typescript --local > packages/shared/src/database.types.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "typescript": "^7.0.2"
  }
}
