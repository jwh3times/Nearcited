{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nearcited",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Before every dev session, deploy and dry run, write the tuning file the Worker bundles:
  // the private values when private/tuning.json exists, otherwise a marker for the public
  // defaults. See docs/adr/0001-private-tuning-as-data.md.
  "build": { "command": "node ../../scripts/prepare-tuning.mjs", "watch_dir": "src" },
  "alias": { "nearcited-tuning": "./.tuning/tuning.json" },

  // The React app. Build it first (`pnpm build` at the repo root). Unknown paths fall back to
  // index.html so client-side routes work; only /api/* runs the Worker.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Daily at 09:00 UTC: queue scans for locations that are due.
  "triggers": { "crons": ["0 9 * * *"] },

  "queues": {
    "producers": [{ "queue": "nearcited-scans", "binding": "SCAN_QUEUE" }],
    "consumers": [
      {
        "queue": "nearcited-scans",
        "max_batch_size": 5,
        "max_batch_timeout": 10,
        "max_retries": 3,
        "retry_delay": 60,
        "dead_letter_queue": "nearcited-scans-dlq"
      }
    ]
  },

  // Not secret. Secrets (SUPABASE_SECRET_KEY, RESEND_API_KEY) go in .dev.vars locally and
  // `wrangler secret put` in production.
  "vars": {
    "SUPABASE_URL": "https://YOUR-PROJECT.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_REPLACE_ME",
    // "mock" serves generated data. Anything else is live, and live has no providers yet.
    "PROVIDER_MODE": "mock",
    "APP_URL": "http://localhost:5173",
    "EMAIL_FROM": "Nearcited <reports@example.com>"
  }
}
