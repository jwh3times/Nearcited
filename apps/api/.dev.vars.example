# Copy to .dev.vars (gitignored). Values here override "vars" in wrangler.jsonc during `wrangler dev`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_from_supabase_status
SUPABASE_SECRET_KEY=sb_secret_from_supabase_status
PROVIDER_MODE=mock
APP_URL=http://localhost:5173
# Optional. The commit this deployment was built from; shown in the operator's view.
COMMIT=
EMAIL_FROM=Nearcited <reports@example.com>
# Optional. Where a reply to a scan report goes. Blank leaves replies to go to EMAIL_FROM.
EMAIL_REPLY_TO=
# Optional. Only used when PROVIDER_MODE is not mock: live scans check ChatGPT when this is set.
OPENAI_API_KEY=
# Optional. The same, for Claude. It also writes drafts on real data, once the private tuning has
# instructions for them.
ANTHROPIC_API_KEY=
# Optional. Leave blank to skip sending emails. Without it, a deployment on live data cannot
# approve an action.
RESEND_API_KEY=
# Optional. Both are needed before anyone can subscribe: a Stripe secret key (a test-mode one
# outside production) and the signing secret of the webhook endpoint at /api/stripe/webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional secret. The key a connection's sign-in is sealed with: 32 random bytes in base64
# (`openssl rand -base64 32`). Left blank, nothing can be connected. `pnpm local:env` makes one
# for this machine. Changing it makes every sign-in already kept unreadable.
CONNECTIONS_KEY=
# Optional, and only on your own machine: the one origin of a WordPress you run here for testing,
# such as http://localhost:8099, which the Worker may then reach over http. Never on a deployment.
WORDPRESS_LOCAL_ORIGIN=
