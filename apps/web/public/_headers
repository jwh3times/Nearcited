# The line a business pastes into its own site. Every page of every such site asks for it, so a
# browser keeps it for an hour, and a site that only loads what says it may be loaded can.
/line.js
  Cache-Control: public, max-age=3600
  Cross-Origin-Resource-Policy: cross-origin

# Where WordPress sends an owner back, with the password it made on the address. The app takes it
# off at once, but the page's own files are asked for first, and a browser would name the whole
# address to each of them.
/wordpress/return
  Referrer-Policy: no-referrer
